/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "angolomilano-slack",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-06",
	"upload_source_maps": true,
	// wrangler runs this before `deploy` / `dev`, so CI (Workers Builds) that
	// only calls `npx wrangler deploy` still produces web/dist
	"build": {
		"command": "pnpm --filter angolomilano-web build"
	},
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		// only these hit the Worker, everything else is static
		"run_worker_first": [
			"/api/*",
			"/slack/*"
		]
	},
	// TODO: once the domain is on Cloudflare, uncomment, and after moving the
	// Slack request URLs to it, also set workers_dev/preview_urls to false.
	"routes": [
		{
			"pattern": "angolomilano.untitled.dev",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	// "preview_urls": false,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"triggers": {
		"crons": [
			"*/30 7-11 * * 2-5", // tue-thu every 30min, 09:00-13:30 CET
			"0 12 * * 2-5" // tue-thu 14:00 CET (last run of the window)
		]
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"browser": {
		"binding": "BROWSER"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MENU_REFRESHER",
				"class_name": "MenuRefresher"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MenuRefresher"
			]
		}
	],
	"kv_namespaces": [
		{
			"binding": "ANGOLOMILANO_MENU_KV",
			"id": "44da9db16521476b8f45164312001351",
			"preview_id": "aad6b54f323a437f9272700549c59d8e",
			"remote": false
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "angolo-menu-embeddings",
			"remote": true
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
