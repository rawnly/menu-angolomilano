{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte", "vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
